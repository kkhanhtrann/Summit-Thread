{
  "openapi": "3.1.0",
  "info": {
    "title": "Summit Thread foundation",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health/live": {
      "get": {
        "operationId": "live",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Dependencies are ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Dependencies are unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create a live conference room",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New room code and empty session snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSnapshot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/sessions/{sessionId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "get": {
        "operationId": "getSession",
        "summary": "Get released captions and current session state",
        "responses": {
          "200": {
            "description": "Current session snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSnapshot"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/sessions/{sessionId}/recording": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "post": {
        "operationId": "uploadSessionRecording",
        "summary": "Upload an audio or video recording for preparation",
        "requestBody": {
          "required": true,
          "content": {
            "audio/mpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/mp4": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/wav": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/webm": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "video/mp4": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "video/webm": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "video/quicktime": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Recording accepted and preparation started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Unavailable"
          },
          "413": {
            "$ref": "#/components/responses/Unavailable"
          },
          "415": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "description": "Stream a supported audio/video file up to 300 MiB. Validate source duration and audio with ffprobe before readiness. No AI analysis is required."
      }
    },
    "/sessions/{sessionId}/recording/playback": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "post": {
        "operationId": "updateRecordingPlayback",
        "summary": "Synchronize room playback and release reached content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaybackUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current recording playback state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/sessions/{sessionId}/recording/media": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "get": {
        "operationId": "getSessionRecordingMedia",
        "summary": "Stream the room recording with byte-range seeking",
        "responses": {
          "200": {
            "description": "Room recording content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Requested recording byte range"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Unavailable"
          },
          "416": {
            "description": "Requested byte range is invalid"
          }
        }
      }
    },
    "/sessions/{sessionId}/events": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "get": {
        "operationId": "subscribeToSessionEvents",
        "summary": "Receive a fresh snapshot and subsequent session updates",
        "responses": {
          "200": {
            "description": "Server-Sent Events stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/sessions/{sessionId}/chat": {
      "post": {
        "operationId": "askPrivateQuestion",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{8}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrivateChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grounded answer, cited excerpt, or abstention",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/ask-context": {
      "get": {
        "operationId": "getPrivateAskContext",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{8}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Released content available to private Ask",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateAskContext"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{sessionId}/visual-moments/{momentId}/image": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        },
        {
          "name": "momentId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^moment-\\d{4}$"
          }
        }
      ],
      "get": {
        "operationId": "getVisualMomentImage",
        "summary": "Read the original still for a released visual moment",
        "description": "Returns image bytes only for a moment already released in this room. Unknown, unreleased, and other-room IDs share one 404 response.",
        "responses": {
          "200": {
            "description": "Original frame extracted from the room source",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Visual moment not found, not released, or its image is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{sessionId}/recording/live/windows/{index}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        },
        {
          "name": "index",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          }
        }
      ],
      "post": {
        "operationId": "submitLiveVisualWindow",
        "summary": "Submit one completed live-camera clip for visual review",
        "description": "Accepts clips in capture order. Repeating an already committed index is a no-op; a later index is rejected. Attendee media is not carried by this route.",
        "requestBody": {
          "required": true,
          "content": {
            "video/webm": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "video/mp4": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "video/quicktime": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Clip reviewed and its window committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Source is not a ready live camera or the clip is out of order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Clip exceeds the local size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Visual review is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{sessionId}/recording/live/start": {
      "post": {
        "operationId": "startLiveCapture",
        "summary": "Start a fresh camera source",
        "responses": {
          "201": {
            "description": "Committed camera source",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "recording"
                  ],
                  "properties": {
                    "recording": {
                      "$ref": "#/components/schemas/SessionRecording"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid room or cadence"
          },
          "409": {
            "description": "Source conflict or unavailable"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "analysisWindowMinutes"
                ],
                "properties": {
                  "analysisWindowMinutes": {
                    "type": "integer",
                    "enum": [
                      1,
                      3,
                      5,
                      10
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ]
    },
    "/sessions/{sessionId}/recording/live/stop": {
      "post": {
        "operationId": "stopLiveCapture",
        "summary": "End camera capture after speech finalization",
        "responses": {
          "200": {
            "description": "Committed camera source",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "recording"
                  ],
                  "properties": {
                    "recording": {
                      "$ref": "#/components/schemas/SessionRecording"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid room or cadence"
          },
          "409": {
            "description": "Source conflict or unavailable"
          },
          "503": {
            "description": "Temporarily unavailable"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ]
    },
    "/api/sessions/{sessionId}/materials": {
      "get": {
        "operationId": "listMaterials",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{8}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room materials without their text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid room code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addTextMaterial",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{8}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTextMaterialRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored notes and their final status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid title or text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/materials/pdf": {
      "post": {
        "operationId": "uploadPdfMaterial",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{8}$"
            }
          },
          {
            "in": "header",
            "name": "X-Material-Title",
            "required": true,
            "description": "Percent-encoded display title, 1-100 characters",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 26214400
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Extracted PDF and its final status (ready or empty)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid title",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Room not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "PDF over 25 MiB or 300 pages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "415": {
            "description": "Not a PDF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "PDF could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/materials/{materialId}": {
      "delete": {
        "operationId": "deleteMaterial",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{8}$"
            }
          },
          {
            "in": "path",
            "name": "materialId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Material, passages, and search documents removed"
          },
          "400": {
            "description": "Invalid room code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Room or material not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "required": [
          "id",
          "title",
          "eventName",
          "speakerName",
          "contentLabel",
          "revision",
          "releasedCount",
          "isLive"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "eventName": {
            "type": "string"
          },
          "speakerName": {
            "type": "string"
          },
          "contentLabel": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "releasedCount": {
            "type": "integer",
            "minimum": 0
          },
          "isLive": {
            "type": "boolean"
          }
        }
      },
      "Caption": {
        "type": "object",
        "required": [
          "id",
          "sequence",
          "timestampMs",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "occurrenceId": {
            "type": "string"
          }
        }
      },
      "TopicOccurrence": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "startedAtMs",
          "endedAtMs",
          "evidenceCaptionIds",
          "captions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "startedAtMs": {
            "type": "integer",
            "minimum": 0
          },
          "endedAtMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidenceCaptionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Caption"
            }
          }
        }
      },
      "TopicThread": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "occurrences"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "occurrences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicOccurrence"
            }
          }
        }
      },
      "SessionSnapshot": {
        "type": "object",
        "required": [
          "session",
          "captions",
          "threads",
          "activeOccurrenceId",
          "suggestedQuestions",
          "topicAnalysisSkippedCaptionCount",
          "recording",
          "visualMoments"
        ],
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "captions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Caption"
            }
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicThread"
            }
          },
          "activeOccurrenceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggestedQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topicAnalysisSkippedCaptionCount": {
            "type": "integer",
            "minimum": 0
          },
          "recording": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionRecording"
              },
              {
                "type": "null"
              }
            ]
          },
          "visualMoments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisualMoment"
            }
          }
        }
      },
      "SessionRecording": {
        "type": "object",
        "required": [
          "sourceType",
          "status",
          "preparationStage",
          "mediaKind",
          "mimeType",
          "durationMs",
          "playbackPositionMs",
          "isPlaying",
          "analysisWindowMinutes",
          "visualReviewSkippedWindowCount",
          "analysisThroughMs",
          "analysisState",
          "mediaUrl",
          "playbackUpdatedAt"
        ],
        "properties": {
          "sourceType": {
            "enum": [
              "upload",
              "camera"
            ]
          },
          "status": {
            "enum": [
              "preparing",
              "ready",
              "failed"
            ]
          },
          "preparationStage": {
            "enum": [
              "uploading",
              null
            ]
          },
          "mediaKind": {
            "enum": [
              "audio",
              "video"
            ]
          },
          "mimeType": {
            "type": "string"
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "playbackPositionMs": {
            "type": "integer",
            "minimum": 0
          },
          "isPlaying": {
            "type": "boolean"
          },
          "analysisWindowMinutes": {
            "enum": [
              1,
              3,
              5,
              10
            ]
          },
          "visualReviewSkippedWindowCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "analysisThroughMs": {
            "type": "integer",
            "minimum": 0
          },
          "analysisState": {
            "enum": [
              "waiting",
              "analyzing",
              "ready",
              "failed",
              "complete"
            ]
          },
          "mediaUrl": {
            "type": "string"
          },
          "playbackUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VisualMoment": {
        "type": "object",
        "required": [
          "id",
          "timestampMs",
          "topicTitle",
          "description",
          "imageUrl",
          "captionId",
          "occurrenceId",
          "threadId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^moment-\\d{4}$"
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0,
            "description": "Original source time of the frame"
          },
          "topicTitle": {
            "type": "string",
            "maxLength": 120,
            "description": "Short label for what is on screen"
          },
          "description": {
            "type": "string",
            "maxLength": 280,
            "description": "Alternative text describing the visible content"
          },
          "imageUrl": {
            "type": "string"
          },
          "captionId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Released caption spoken at or shortly before the still"
          },
          "occurrenceId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Topic occurrence of that caption, when topic analysis assigned one"
          },
          "threadId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Topic thread of that occurrence"
          }
        },
        "description": "A released original still. Delivered in room snapshots and visual_moment_released events."
      },
      "RecordingResponse": {
        "type": "object",
        "required": [
          "recording"
        ],
        "properties": {
          "recording": {
            "$ref": "#/components/schemas/SessionRecording"
          }
        }
      },
      "PlaybackUpdate": {
        "type": "object",
        "required": [
          "positionMs",
          "isPlaying"
        ],
        "properties": {
          "positionMs": {
            "type": "integer",
            "minimum": 0
          },
          "isPlaying": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": false
      },
      "SessionEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SessionSnapshotEvent"
          },
          {
            "$ref": "#/components/schemas/CaptionReleasedEvent"
          },
          {
            "$ref": "#/components/schemas/LiveStatusChangedEvent"
          },
          {
            "$ref": "#/components/schemas/TopicUpdatedEvent"
          },
          {
            "$ref": "#/components/schemas/RecordingUpdatedEvent"
          },
          {
            "$ref": "#/components/schemas/VisualMomentReleasedEvent"
          }
        ]
      },
      "SessionSnapshotEvent": {
        "type": "object",
        "required": [
          "type",
          "session",
          "captions",
          "threads",
          "activeOccurrenceId",
          "suggestedQuestions",
          "topicAnalysisSkippedCaptionCount",
          "recording",
          "visualMoments"
        ],
        "properties": {
          "type": {
            "const": "snapshot"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "captions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Caption"
            }
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicThread"
            }
          },
          "activeOccurrenceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggestedQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topicAnalysisSkippedCaptionCount": {
            "type": "integer",
            "minimum": 0
          },
          "recording": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionRecording"
              },
              {
                "type": "null"
              }
            ]
          },
          "visualMoments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisualMoment"
            }
          }
        }
      },
      "CaptionReleasedEvent": {
        "type": "object",
        "required": [
          "type",
          "revision",
          "caption"
        ],
        "properties": {
          "type": {
            "const": "caption_released"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "caption": {
            "$ref": "#/components/schemas/Caption"
          }
        }
      },
      "LiveStatusChangedEvent": {
        "type": "object",
        "required": [
          "type",
          "revision",
          "isLive"
        ],
        "properties": {
          "type": {
            "const": "live_status_changed"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "isLive": {
            "type": "boolean"
          }
        }
      },
      "TopicUpdatedEvent": {
        "type": "object",
        "required": [
          "type",
          "revision",
          "snapshot"
        ],
        "properties": {
          "type": {
            "const": "topic_updated"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot": {
            "$ref": "#/components/schemas/SessionSnapshot"
          }
        }
      },
      "RecordingUpdatedEvent": {
        "type": "object",
        "required": [
          "type",
          "revision",
          "recording"
        ],
        "properties": {
          "type": {
            "const": "recording_updated"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "recording": {
            "$ref": "#/components/schemas/SessionRecording"
          }
        }
      },
      "VisualMomentReleasedEvent": {
        "type": "object",
        "required": [
          "type",
          "revision",
          "moment"
        ],
        "properties": {
          "type": {
            "const": "visual_moment_released"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "moment": {
            "$ref": "#/components/schemas/VisualMoment"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "PrivateChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "history": {
            "type": "array",
            "maxItems": 8,
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          },
          "contextCaptionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "PrivateChatResponse": {
        "type": "object",
        "required": [
          "answer",
          "citations"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CaptionCitation"
                },
                {
                  "$ref": "#/components/schemas/MaterialCitation"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "caption": "#/components/schemas/CaptionCitation",
                  "material": "#/components/schemas/MaterialCitation"
                }
              }
            }
          }
        }
      },
      "PrivateAskContext": {
        "type": "object",
        "required": [
          "session",
          "captions",
          "suggestedQuestions"
        ],
        "properties": {
          "session": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "sequence",
                "timestampMs",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "sequence": {
                  "type": "integer"
                },
                "timestampMs": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "suggestedQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Material": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "status",
          "pageCount",
          "passageCount",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "pdf"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "processing",
              "ready",
              "empty",
              "failed"
            ],
            "description": "empty means the PDF had no extractable text"
          },
          "pageCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "passageCount": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MaterialResponse": {
        "type": "object",
        "required": [
          "material"
        ],
        "properties": {
          "material": {
            "$ref": "#/components/schemas/Material"
          }
        }
      },
      "MaterialList": {
        "type": "object",
        "required": [
          "materials"
        ],
        "properties": {
          "materials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Material"
            }
          }
        }
      },
      "CreateTextMaterialRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        }
      },
      "CaptionCitation": {
        "type": "object",
        "required": [
          "kind",
          "captionId",
          "timestampMs",
          "text"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "caption"
          },
          "captionId": {
            "type": "string"
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "MaterialCitation": {
        "type": "object",
        "required": [
          "kind",
          "passageId",
          "materialTitle",
          "page",
          "text"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "material"
          },
          "passageId": {
            "type": "string"
          },
          "materialTitle": {
            "type": "string"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "SessionId": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "The session does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "A required service dependency is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
